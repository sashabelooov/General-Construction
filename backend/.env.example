DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional; defaults to sqlite for local dev)
# DJANGO_DATABASE_URL=postgres://user:pass@localhost:5432/general_construction

# CORS (dev)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Media/static
DJANGO_MEDIA_URL=/media/
DJANGO_STATIC_URL=/static/

# ----- Uysot CRM Integration -----
UYSOT_BASE_URL=https://service.app.uysot.uz/v1/external-source
UYSOT_AUTH_TOKEN=your-uysot-x-auth-token-here
