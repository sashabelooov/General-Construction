# ===========================================
# General Construction - Docker Environment
# ===========================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ----- Django -----
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_ADMIN_URL=your-secret-admin-path

# ----- CORS (comma-separated origins) -----
# Leave empty if frontend is served by the same Nginx (recommended)
DJANGO_CORS_ALLOWED_ORIGINS=

# ----- PostgreSQL -----
POSTGRES_DB=general_construction
POSTGRES_USER=gc_user
POSTGRES_PASSWORD=change-this-strong-password

# ----- Uysot CRM Integration -----
UYSOT_BASE_URL=https://service.app.uysot.uz/v1/external-source
UYSOT_AUTH_TOKEN=your-uysot-jwt-token-here
